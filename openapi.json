{
  "openapi": "3.0.3",
  "info": {
    "title": "Solar API",
    "description": "API interne pour la plateforme Solar (Association Le Trèfle 2.0). Supporte l'authentification par Bearer JWT ou API Key.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.beta.letrefle.org/",
      "description": "Serveur de production"
    },
    {
      "url": "http://localhost:3001",
      "description": "Serveur de développement local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "name": "token",
        "in": "header"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "name": "token",
        "in": "query"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "displayUsername": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "discordID": {
            "type": "string",
            "nullable": true
          },
          "replyID": {
            "type": "integer",
            "nullable": true
          },
          "edited": {
            "type": "boolean"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "statusName": {
            "type": "string"
          },
          "statusLabel": {
            "type": "string"
          },
          "channelId": {
            "type": "string",
            "nullable": true
          },
          "assignedUserId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "string",
            "description": "JSON string of permission array"
          },
          "weight": {
            "type": "integer"
          },
          "icon": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Newsletter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "scheduled",
              "sent"
            ]
          },
          "authorId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKeyAuth": []
    },
    {
      "apiKeyQuery": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Vérification de l'état du serveur",
        "responses": {
          "200": {
            "description": "Serveur opérationnel"
          }
        }
      }
    },
    "/v1/users/{id}": {
      "get": {
        "summary": "Récupérer un utilisateur par ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Utilisateur trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Non autorisé"
          },
          "404": {
            "description": "Utilisateur non trouvé"
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "summary": "Envoyer un nouveau message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channelId",
                  "content"
                ],
                "properties": {
                  "channelId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "discordID": {
                    "type": "string"
                  },
                  "replyID": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message envoyé avec succès"
          },
          "400": {
            "description": "Données invalides"
          }
        }
      }
    },
    "/v1/messages/{channelId}": {
      "get": {
        "summary": "Récupérer l'historique des messages d'un salon",
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "ID du message pour la pagination"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Message"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/message/{id}": {
      "put": {
        "summary": "Modifier un message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message modifié"
          }
        }
      },
      "delete": {
        "summary": "Supprimer un message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message supprimé"
          }
        }
      }
    },
    "/v1/reaction": {
      "post": {
        "summary": "Ajouter ou supprimer une réaction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "messageID",
                  "authorID",
                  "reaction",
                  "option"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "ID de la réaction (nécessaire pour suppression)"
                  },
                  "messageID": {
                    "type": "integer"
                  },
                  "authorID": {
                    "type": "string"
                  },
                  "reaction": {
                    "type": "string",
                    "description": "L'émoji utilisé"
                  },
                  "option": {
                    "type": "string",
                    "enum": [
                      "add",
                      "remove"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réaction traitée avec succès"
          }
        }
      }
    },
    "/v1/tickets": {
      "get": {
        "summary": "Lister les tickets (selon permissions)",
        "responses": {
          "200": {
            "description": "Liste des tickets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "tickets": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ticket"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/history": {
      "get": {
        "summary": "Historique des tickets fermés/commentés",
        "responses": {
          "200": {
            "description": "Historique des tickets"
          }
        }
      }
    },
    "/v1/tickets/assign": {
      "post": {
        "summary": "Assigner un ticket à un utilisateur",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ticketID",
                  "assignmentID"
                ],
                "properties": {
                  "ticketID": {
                    "type": "integer"
                  },
                  "assignmentID": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket assigné"
          }
        }
      }
    },
    "/v1/admin/roles": {
      "get": {
        "summary": "Lister tous les rôles",
        "responses": {
          "200": {
            "description": "Liste des rôles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "roles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Role"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Créer ou mettre à jour un rôle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "permissions",
                  "weight"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "permissions": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer"
                  },
                  "icon": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rôle enregistré"
          }
        }
      }
    },
    "/v1/admin/roles/{id}": {
      "delete": {
        "summary": "Supprimer un rôle",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rôle supprimé"
          }
        }
      }
    },
    "/v1/admin/users/{id}/role": {
      "post": {
        "summary": "Attribuer des rôles à un utilisateur",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "roles"
                ],
                "properties": {
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rôles mis à jour"
          }
        }
      }
    },
    "/v1/bot/status": {
      "get": {
        "summary": "Statut actuel du bot",
        "responses": {
          "200": {
            "description": "Statut du bot renvoyé"
          }
        }
      }
    },
    "/v1/bot/setup": {
      "post": {
        "summary": "Configuration/Réinitialisation du bot",
        "responses": {
          "200": {
            "description": "Bot configuré, clé API générée"
          }
        }
      }
    },
    "/v1/newsletters": {
      "get": {
        "summary": "Lister les newsletters",
        "responses": {
          "200": {
            "description": "Liste des newsletters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Newsletter"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Créer une newsletter",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "htmlContent": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Newsletter créée"
          }
        }
      }
    },
    "/v1/newsletters/{id}": {
      "get": {
        "summary": "Récupérer une newsletter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Détails de la newsletter"
          }
        }
      },
      "put": {
        "summary": "Mettre à jour une newsletter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "htmlContent": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "scheduled"
                    ]
                  },
                  "scheduledAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mise à jour réussie"
          }
        }
      },
      "delete": {
        "summary": "Supprimer une newsletter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newsletter supprimée"
          }
        }
      }
    },
    "/v1/newsletters/{id}/send": {
      "post": {
        "summary": "Envoyer une newsletter immédiatement",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newsletter envoyée"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "Lister tous les événements",
        "responses": {
          "200": {
            "description": "Liste des événements"
          }
        }
      },
      "post": {
        "summary": "Créer un événement",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "start",
                  "end",
                  "userId",
                  "roleSlots"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "userId": {
                    "type": "string"
                  },
                  "roleSlots": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "goalCount": {
                          "type": "integer"
                        },
                        "part": {
                          "type": "string",
                          "enum": [
                            "first",
                            "second"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Événement créé"
          }
        }
      }
    },
    "/v1/auth/get-session": {
      "get": {
        "summary": "Récupérer la session utilisateur actuelle",
        "responses": {
          "200": {
            "description": "Session active",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié"
          }
        }
      }
    },
    "/v1/widget/session": {
      "post": {
        "summary": "Initialiser ou récupérer une session de chat visiteur (Widget)",
        "description": "Utilise les cookies pour maintenir la session du visiteur. Crée un nouveau ticket si aucun n'est actif.",
        "responses": {
          "200": {
            "description": "Session initialisée",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "channelId": {
                      "type": "string"
                    },
                    "credentials": {
                      "type": "object",
                      "properties": {
                        "channelId": {
                          "type": "string"
                        },
                        "uid": {
                          "type": "string"
                        },
                        "exp": {
                          "type": "integer"
                        },
                        "sig": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/widget/close": {
      "post": {
        "summary": "Fermer la session du widget",
        "responses": {
          "200": {
            "description": "Session fermée, cookies supprimés"
          }
        }
      }
    },
    "/v1/ws/guest": {
      "post": {
        "summary": "Générer des identifiants d'invité pour le WebSocket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channelId"
                ],
                "properties": {
                  "channelId": {
                    "type": "string"
                  },
                  "uid": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identifiants générés",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "credentials": {
                      "type": "object",
                      "properties": {
                        "channelId": {
                          "type": "string"
                        },
                        "uid": {
                          "type": "string"
                        },
                        "exp": {
                          "type": "integer"
                        },
                        "sig": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://api.beta.letrefle.org/"
    }
  ]
}