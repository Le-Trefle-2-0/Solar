generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Newsletter {
  id          String    @id @default(cuid())
  title       String
  content     Bytes
  status      String    @default("draft")
  target      String    @default("private")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  scheduledAt DateTime?
  authorId    String
  htmlContent Bytes?
  author      User      @relation(fields: [authorId], references: [id])

  @@index([authorId], map: "newsletter_authorId_fkey")
  @@map("newsletter")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscriber")
}

model User {
  id                     String              @id
  name                   String              @db.Text
  email                  String              @unique
  emailVerified          Boolean
  image                  String?             @db.LongText
  createdAt              DateTime
  updatedAt              DateTime
  banExpires             DateTime?
  banReason              String?             @db.Text
  banned                 Boolean?
  role                   String?             @db.Text
  twoFactorEnabled       Boolean?
  displayUsername        String?             @db.Text
  username               String?             @unique
  documentsRenewalAt     DateTime?
  documentsSentAt        DateTime?
  documentsStatus        String?             @default("missing")
  documentsText          String?             @db.Text
  documentsValidatedAt   DateTime?
  addressCity            String?             @db.Text
  addressNumber          String?             @db.Text
  addressPostalCode      String?             @db.Text
  addressStreet          String?             @db.Text
  birthDate              DateTime?
  casierFileId           String?
  casierRejectReason     String?             @db.Text
  casierStatus           String?             @default("missing")
  firstName              String?             @db.Text
  idCardFileId           String?
  idCardRejectReason     String?             @db.Text
  idCardStatus           String?             @default("missing")
  lastName               String?             @db.Text
  newsletterSubscription Boolean             @default(false)
  accounts               Account[]
  apikeys                Apikey[]
  events                 Event[]
  eventRegistrations     EventRegistration[]
  invitations            Invitation[]
  members                Member[]
  messages               Message[]
  newsletters            Newsletter[]
  passkeys               Passkey[]
  reactions              Reaction[]
  sessions               Session[]
  tickets                Ticket[]
  twofactors             TwoFactor[]
  channelReads           UserChannelRead[]

  @@map("user")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String   @db.Text
  weight      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  icon        String?

  @@map("role")
}

model File {
  id        String   @id @default(uuid())
  filename  String   @db.Text
  content   Bytes
  mime      String   @db.Text
  size      Int
  createdAt DateTime @default(now())

  @@map("file")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?  @db.Text
  userAgent            String?  @db.Text
  userId               String
  activeOrganizationId String?  @db.Text
  impersonatedBy       String?  @db.Text
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_fkey")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_fkey")
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Organization {
  id          String       @id
  name        String       @db.Text
  slug        String?      @unique
  logo        String?      @db.Text
  createdAt   DateTime
  metadata    String?      @db.Text
  invitations Invitation[]
  members     Member[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @db.Text
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "member_organizationId_fkey")
  @@index([userId], map: "member_userId_fkey")
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String       @db.Text
  role           String?      @db.Text
  status         String       @db.Text
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([inviterId], map: "invitation_inviterId_fkey")
  @@index([organizationId], map: "invitation_organizationId_fkey")
  @@map("invitation")
}

model TwoFactor {
  id          String  @id
  secret      String  @db.Text
  backupCodes String  @db.Text
  userId      String
  verified    Boolean
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "two_factor_userId_fkey")
  @@map("two_factor")
}

model Channel {
  id           String            @id @default(cuid())
  name         String
  events       Event[]
  messages     Message[]
  ticket       Ticket?
  channelReads UserChannelRead[]

  @@unique([id, name])
  @@map("channel")
}

model UserChannelRead {
  userId    String
  channelId String
  lastRead  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@map("user_channel_read")
}

model Message {
  id        Int        @id @default(autoincrement())
  createdAt DateTime
  userId    String?
  channelId String
  content   Bytes
  discordID String?
  edited    Boolean    @default(false)
  replyID   Int?
  ticketId  Int?
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  ticket    Ticket?    @relation(fields: [ticketId], references: [id])
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([channelId], map: "message_channelId_fkey")
  @@index([ticketId], map: "message_ticketId_fkey")
  @@index([userId], map: "message_userId_fkey")
  @@map("message")
}

model Reaction {
  id        String  @id @default(cuid())
  emoji     String
  messageID Int
  userID    String
  message   Message @relation(fields: [messageID], references: [id])
  user      User    @relation(fields: [userID], references: [id])

  @@index([messageID], map: "reaction_messageID_fkey")
  @@index([userID], map: "reaction_userID_fkey")
  @@map("reaction")
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String?
  start         DateTime
  end           DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  userId        String
  channelID     String
  channel       Channel             @relation(fields: [channelID], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  registrations EventRegistration[]
  roleSlots     RoleSlot[]

  @@index([channelID], map: "event_channelID_fkey")
  @@index([userId], map: "event_userId_fkey")
  @@map("event")
}

model RoleSlot {
  id            String              @id @default(cuid())
  role          String
  eventId       String
  goalCount     Int
  part          String?
  registrations EventRegistration[]
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], map: "role_slot_eventId_fkey")
  @@map("role_slot")
}

model EventRegistration {
  id           String   @id @default(cuid())
  userId       String
  roleSlotId   String
  registeredAt DateTime @default(now())
  eventId      String?
  status       String   @default("confirmed")
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleSlot     RoleSlot @relation(fields: [roleSlotId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleSlotId])
  @@index([eventId], map: "event_registration_eventId_fkey")
  @@index([roleSlotId], map: "event_registration_roleSlotId_fkey")
  @@map("event_registration")
}

model Ticket {
  id             Int          @id @default(autoincrement())
  discordUserID  String
  channelId      String?      @unique
  createdAt      DateTime
  updatedAt      DateTime
  assignedUserId String?
  channelName    String?
  statusLabel    String
  statusName     String
  info           String?
  observations   String?
  problematic    String?
  voice          Boolean      @default(false)
  metadata       Json?
  source         String       @default("discord")
  categories     Json?
  feedback       Json?
  messages       Message[]
  user           User?        @relation(fields: [assignedUserId], references: [id])
  channel        Channel?     @relation(fields: [channelId, channelName], references: [id, name], onDelete: Cascade)
  status         TicketStatus @relation(fields: [statusName, statusLabel], references: [name, label])

  @@unique([channelId, channelName])
  @@index([assignedUserId], map: "ticket_assignedUserId_fkey")
  @@index([channelId, channelName], map: "ticket_channelId_channelName_fkey")
  @@index([statusName, statusLabel], map: "ticket_statusName_statusLabel_fkey")
  @@map("ticket")
}

model TicketStatus {
  id     Int      @id @default(autoincrement())
  name   String   @unique(map: "name") @db.VarChar(192)
  label  String   @db.VarChar(192)
  ticket Ticket[]

  @@unique([name, label])
  @@map("ticket_status")
}

model Apikey {
  id                  String    @id
  name                String?   @db.Text
  start               String?   @db.Text
  prefix              String?   @db.Text
  key                 String    @db.Text
  userId              String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?   @db.Text
  metadata            String?   @db.Text
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "apikey_userId_fkey")
  @@map("apikey")
}

model Jwks {
  id         String   @id
  publicKey  String   @db.Text
  privateKey String   @db.Text
  createdAt  DateTime

  @@map("jwks")
}

model RouteProtection {
  id                       String  @id
  route                    String  @unique
  isRoleProtected          Boolean
  roleProtection           String  @db.Text
  isAuthenticatedProtected Boolean

  @@map("route_protection")
}

model Passkey {
  id           String    @id
  name         String?   @db.Text
  publicKey    String    @db.Text
  userId       String
  credentialID String    @db.Text
  counter      Int
  deviceType   String    @db.Text
  backedUp     Boolean
  transports   String?   @db.Text
  createdAt    DateTime?
  aaguid       String?   @db.Text
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "passkey_userId_fkey")
  @@map("passkey")
}

model Recruitment {
  id               String                @id @default(cuid())
  title            String
  description      String                @db.LongText
  shortDescription String?               @db.Text
  icon             String?
  fields           Json
  enabled          Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  contactEmail     String?
  discordWebhook   String?               @db.Text
  waitlist         RecruitmentWaitlist[]

  @@map("recruitment")
}

model RecruitmentWaitlist {
  id            String      @id @default(cuid())
  email         String
  recruitmentId String
  createdAt     DateTime    @default(now())
  recruitment   Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)

  @@unique([email, recruitmentId])
  @@index([recruitmentId], map: "recruitment_waitlist_recruitmentId_fkey")
  @@map("recruitment_waitlist")
}

model TeamCategory {
  id        String       @id @default(cuid())
  name      String
  icon      String?
  order     Int          @default(0)
  members   TeamMember[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("team_category")
}

model TeamMember {
  id         String       @id @default(cuid())
  name       String
  role       String
  image      String?      @db.LongText
  bio        String?      @db.Text
  categoryId String
  category   TeamCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([categoryId], map: "team_member_categoryId_fkey")
  @@map("team_member")
}

model Image {
  id   String @id @default(cuid())
  link String @db.LongText

  @@map("image")
}

model Settings {
  key   String @id
  value String @db.Text

  @@map("settings")
}
