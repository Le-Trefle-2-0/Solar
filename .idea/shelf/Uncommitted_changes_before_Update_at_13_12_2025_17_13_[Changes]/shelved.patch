 apiKey({\r\n            rateLimit: {\r\n                enabled: false\r\n            }\r\n        }),\r\n        jwt(),\r\n        bearer(),\r\n        dashboardPlugin(),\r\n        passkey()\r\n    ],\r\n    account: {\r\n        accountLinking: {\r\n            enabled: true\r\n        }\r\n    },\r\n    socialProviders: {\r\n        discord: {\r\n            clientId: process.env.DISCORD_CLIENT_ID as string,\r\n            clientSecret: process.env.DISCORD_CLIENT_SECRET as string,\r\n        }\r\n    }\r\n});
