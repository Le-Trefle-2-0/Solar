{
  "name": "solar-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "db": "prisma migrate reset -y",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "postinstall": "flowbite-react patch && prisma generate --schema=prisma/schema.prisma && (cd apps/web && ln -sf ../../.env .env)",
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "dev:api": "npm run dev -w apps/api",
    "dev:ws": "npm run dev -w websocket-service",
    "dev:voice": "npm run dev -w apps/voice",
    "dev:storage": "npm run dev -w apps/storage",
    "dev:all": "concurrently -k -p \"[{name}]\" -c blue,magenta,green,yellow,cyan \"npm:dev:api\" \"npm:dev:ws\" \"npm:dev:voice\" \"npm:dev:storage\" \"npm:dev:web\"",
    "build:api": "npm run build -w apps/api",
    "build:ws": "npm run build -w websocket-service",
    "build:voice": "npm run build -w apps/voice",
    "build:storage": "npm run build -w apps/storage",
    "start:api": "npm run start -w apps/api",
    "start:ws": "npm run start -w websocket-service",
    "start:voice": "npm run start -w apps/voice",
    "start:storage": "npm run start -w apps/storage",
    "start:all": "concurrently -k -p \"[{name}]\" -c blue,magenta,green,yellow,cyan \"npm:start:api\" \"npm:start:ws\" \"npm:start:voice\" \"npm:start:storage\" \"npm:start:web\"",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "build:all": "npm run build:api && npm run build:ws && npm run build:voice && npm run build:storage && npm run build:web",
    "start:web": "npm run start -w apps/web",
    "compose:up": "docker compose up",
    "compose:down": "docker compose down -v",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "generate:data": "tsx scripts/generate-historical-data.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "zod": "3.25.76"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.2",
